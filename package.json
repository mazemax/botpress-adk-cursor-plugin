{
  "name": "botpress-adk-cursor-plugin",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Maintainer tooling for the Botpress ADK Community Cursor distribution.",
  "type": "module",
  "license": "MIT",
  "author": "mazemax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mazemax/botpress-adk-cursor-plugin.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "generate:commands": "tsx scripts/generate-commands.ts --write",
    "check:commands": "tsx scripts/generate-commands.ts --check",
    "check:references": "tsx scripts/check-references.ts",
    "measure:context": "tsx scripts/measure-context.ts",
    "sync:check": "tsx scripts/sync-upstream.ts --check",
    "sync:verify": "tsx scripts/sync-upstream.ts --verify",
    "sync:apply": "tsx scripts/sync-upstream.ts --apply",
    "test": "vitest run",
    "check": "npm run typecheck && npm run check:commands && npm run validate && npm run check:references && npm run measure:context && npm test"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
